# Variables de entorno del backend (NestJS).
# Copiar este archivo a .env y completar con los valores reales.
# NUNCA commitear el .env con credenciales.

# URL del proyecto Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Clave pública anon. No salta RLS: la autorización depende de las policies.
SUPABASE_ANON_KEY=

# Puerto HTTP. En Render se asigna automáticamente; en local usar 8080.
PORT=
